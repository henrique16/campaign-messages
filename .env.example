# Porta do api (publicada igual no host). Padrão: 3000
PORT=3000

# Vazio = Sentry desligado. Preencha só para ligar.
SENTRY_DSN=

# Endpoint OTLP HTTP do collector. Dentro do Compose: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# MySQL do app (ainda não usado pelo processo neste marco). Vazio = padrão local do compose.
MYSQL_DATABASE=campaign_messages
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Postgres do SonarQube (separado do MySQL do app). Vazio = padrão local do compose.
SONAR_DB_USER=
SONAR_DB_PASSWORD=
