# Porta do api (publicada igual no host).
PORT=3000

# Vazio = Sentry desligado.
SENTRY_DSN=

# Endpoint OTLP HTTP do collector, visto de dentro do Compose.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# MySQL do app. Os mesmos valores que o compose usa quando as variáveis estão vazias,
# e os que a suíte de integração usa em 127.0.0.1:3306.
MYSQL_DATABASE=campaign_messages
MYSQL_USER=campaign
MYSQL_PASSWORD=campaign
MYSQL_ROOT_PASSWORD=root

# Postgres do SonarQube, separado do MySQL do app.
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar
